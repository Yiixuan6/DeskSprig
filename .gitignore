# Publish only source, required assets, scripts and user documentation.
/*
!/.gitignore
!/README.md
!/app.config
!/app.manifest
!/build.ps1
!/build-assets.ps1
!/打开管理页.cmd
!/使用说明.md
!/第三方许可.md

!/src/
/src/*
!/src/*.cs

!/assets/
/assets/*
!/assets/*.png
!/assets/*.ico
!/assets/languages/
/assets/languages/*
!/assets/languages/*.json

!/assets/icons/
/assets/icons/*
!/assets/icons/*.svg
!/assets/icons/LICENSE

!/tests/
/tests/*
!/tests/*.ps1

!/tools/
/tools/*
!/tools/*.cs
!/tools/打开管理页.cmd

!/docs/
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/*.png

# Protect runtime data and credentials even inside allowed folders.
**/data/
**/verification-data*/
**/business.json
**/settings.json
*.bak
*.corrupt-*
.env
.env.*
.ssh/
.npmrc
.pypirc
.netrc
*.pem
*.key
*.pfx
*.p12
*.user
*.suo
*.tmp
*.log
